    {
      "key": "custom_voice",
      "type": "string",
      "label": { "en": "Custom voice", "fr": "Voix personnalisée" },
      "description": {
        "en": "Used when the voice is \"Custom voice\": the ID of a voice designed or cloned in Gradium Studio (the \"List my Gradium Studio voices\" action below shows them), or the https URL of a Phonon voice file (.safetensors).",
        "fr": "Utilisé quand la voix est « Voix personnalisée » : l'identifiant d'une voix créée ou clonée dans Gradium Studio (l'action « Lister mes voix Gradium Studio » ci-dessous les affiche), ou l'URL https d'un fichier de voix Phonon (.safetensors)."
      },
      "placeholder": { "en": "e.g. NbpkqMVS3CJeq2j8", "fr": "ex. NbpkqMVS3CJeq2j8" }
    },
    {
      "key": "gradium_api_key",
      "type": "secret",
      "label": { "en": "Gradium API key", "fr": "Clé API Gradium" },
      "description": {
        "en": "Only for a custom voice given by its ID: create a key in Gradium Studio. The voice is downloaded once, then works offline.",
        "fr": "Uniquement pour une voix personnalisée donnée par son identifiant : créez une clé dans Gradium Studio. La voix est téléchargée une fois, puis fonctionne hors ligne."
      }
    },
    {
      "key": "advanced",
      "type": "section",
      "label": { "en": "Advanced", "fr": "Avancé" },
      "description": {
        "en": "The defaults suit most installations.",
        "fr": "Les valeurs par défaut conviennent à la plupart des installations."
      }
    },
    {
      "key": "speech_rate",
      "type": "select",
      "label": { "en": "Speech rate", "fr": "Débit de parole" },
      "default": "normal",
      "options": [
        { "value": "slower", "label": { "en": "Slower", "fr": "Plus lent" } },
        { "value": "normal", "label": { "en": "Normal", "fr": "Normal" } },
        { "value": "faster", "label": { "en": "Faster", "fr": "Plus rapide" } }
      ]
    },
    {
      "key": "quant",
      "type": "select",
      "label": { "en": "Model weights", "fr": "Poids du modèle" },
      "description": {
        "en": "q8 is smaller and faster on a CPU, with the same voice quality for most uses.",
        "fr": "q8 est plus léger et plus rapide sur un processeur, pour une qualité de voix équivalente dans la plupart des usages."
      },
      "default": "q8",
      "options": [
        { "value": "q8", "label": { "en": "q8 (recommended)", "fr": "q8 (recommandé)" } },
        {
          "value": "f32",
          "label": { "en": "f32 (larger, slower)", "fr": "f32 (plus lourd, plus lent)" }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_voice",
      "label": { "en": "Test the voice", "fr": "Tester la voix" },
      "description": {
        "en": "Synthesizes a sentence with the current model and voice, and reports how long it took. Choose Phonon TTS as the voice of Gladys (Integrations › Artificial Intelligence) to hear it on your speakers.",
        "fr": "Synthétise une phrase avec le modèle et la voix actuels, et indique le temps de génération. Choisissez Phonon TTS comme voix de Gladys (Intégrations › Intelligence artificielle) pour l'entendre sur vos enceintes."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "text",
          "type": "string",
          "label": { "en": "Text (optional)", "fr": "Texte (facultatif)" },
          "placeholder": {
            "en": "Hello, I am the voice of Gladys.",
            "fr": "Bonjour, je suis la voix de Gladys."
          }
        }
      ]
    },
    {
      "key": "list_gradium_voices",
      "label": { "en": "List my Gradium Studio voices", "fr": "Lister mes voix Gradium Studio" },
      "description": {
        "en": "Shows the ID of every voice of your Gradium account (needs the Gradium API key, saved).",
        "fr": "Affiche l'identifiant de chaque voix de votre compte Gradium (nécessite la clé API Gradium, enregistrée)."
      },
      "timeout_seconds": 30
    },
    {
      "key": "restart_engine",
      "label": { "en": "Restart the speech engine", "fr": "Relancer le moteur vocal" },
      "description": {
        "en": "Retries the download and restarts the engine, e.g. after a network failure.",
        "fr": "Relance le téléchargement et redémarre le moteur, par exemple après une panne réseau."
      },
      "timeout_seconds": 30
    }
  ]
}
